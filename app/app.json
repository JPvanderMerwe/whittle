{
  "expo": {
    "name": "whittle",
    "slug": "whittle",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "whittle",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F0D",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bitprimitive.whittle"
    },
    "android": {
      "package": "com.bitprimitive.whittle",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withLoopbackCleartext",
      "./plugins/withShareTarget",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Space Grotesk",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/SpaceGrotesk-400.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-500.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/SpaceGrotesk-600.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono-400.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono-500.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono-600.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          }
        }
      ]
    ]
  }
}
